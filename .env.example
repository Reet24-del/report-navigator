# Copy to .env and add your own key. Never commit .env.
# Offline is the default and required for scoring. Hosted is only a legacy demo path.
ANSWER_MODE=offline
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=30
# Optional absolute path. The default is an OS temporary cache directory.
# REPORT_CACHE_DIR=/absolute/path/to/cache
# TESSDATA_PREFIX=/absolute/path/to/models/tessdata
