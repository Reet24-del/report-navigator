# Copy to .env and add your own key. Never commit .env.
# Offline is required for scoring. Hosted is an explicit optional demo choice.
ANSWER_MODE=offline
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=30
# Shared wall-clock budget for generation, repair and backoff.
GEMMA_DEADLINE_SECONDS=45
# Maximum 3; SDK automatic retries remain disabled.
GEMMA_MAX_ATTEMPTS=2
# Alternative supported hosted model: gemma-4-31b-it. No automatic switching.
# Optional absolute path. The default is an OS temporary cache directory.
# REPORT_CACHE_DIR=/absolute/path/to/cache
# TESSDATA_PREFIX=/absolute/path/to/models/tessdata
