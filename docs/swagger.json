  "components": {
    "schemas": {
      "AnswerResult": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence"
            ],
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations",
            "default": []
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "status",
          "answer"
        ],
        "title": "AnswerResult"
      },
      "Body_upload_document_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF, maximum 20 MiB and 300 pages."
          },
          "mode": {
            "type": "string",
            "enum": [
              "offline",
              "hosted"
            ],
            "title": "Mode",
            "default": "offline"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_documents_post"
      },
      "Citation": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Pdf Page"
          },
          "page_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Label"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "text",
              "page_image"
            ],
            "title": "Source Type",
            "default": "text"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "pdf_page"
        ],
        "title": "Citation"
      },
      "DocumentResponse": {
        "properties": {
          "access_id": {
            "type": "string",
            "title": "Access Id",
            "description": "Random document access token. Keep private; use it as {id} in document routes."
          },
          "mode": {
            "type": "string",
            "enum": [
              "offline",
              "hosted"
            ],
            "title": "Mode"
          },
          "expires_after_idle_seconds": {
            "type": "integer",
            "title": "Expires After Idle Seconds"
          },
          "report": {
            "$ref": "#/components/schemas/ReportInfo"
          }
        },
        "type": "object",
        "required": [
          "access_id",
          "mode",
          "expires_after_idle_seconds",
          "report"
        ],
        "title": "DocumentResponse"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "6.0.0"
          },
          "hosted_available": {
            "type": "boolean",
            "title": "Hosted Available"
          }
        },
        "type": "object",
        "required": [
          "hosted_available"
        ],
        "title": "HealthResponse"
      },
      "QuestionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QuestionRequest",
        "examples": [
          {
            "question": "How does RSA work according to these notes?"
          }
        ]
      },
      "ReportInfo": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "page_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Count"
          },
          "searchable_pages": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Searchable Pages"
          },
          "ocr_pages": {
            "type": "integer",
            "title": "Ocr Pages",
            "default": 0
          },
          "unprocessed_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Unprocessed Pages",
            "default": []
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "supported_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Features",
            "default": [
              "text_answers",
              "page_viewer",
              "offline_numbers",
              "ocr"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "filename",
          "page_count",
          "searchable_pages"
        ],
        "title": "ReportInfo"
      }
    }
  }
}
